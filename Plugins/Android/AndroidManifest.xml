<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml para Glassy
  ============================================================
  PROPOSITO:
    Define el Intent Filter para el deep link "glassy://callback"
    que captura el token OAuth de Google luego del login con Supabase.

  COMO FUNCIONA:
    1. AuthManager.LoginWithGoogle() abre el navegador del dispositivo.
    2. Google autentica al usuario y redirige a glassy://callback#access_token=JWT
    3. Android detecta el scheme "glassy" y lanza de nuevo esta Activity.
    4. Application.deepLinkActivated en AuthManager.cs recibe la URL con el token.

  NOTAS PARA UNITY:
    - Colocar este archivo en Assets/Plugins/Android/AndroidManifest.xml
    - Unity fusiona este manifest con el generado automaticamente al compilar.
    - El atributo android:launchMode="singleTask" es critico: evita que se
      creen multiples instancias de la Activity al volver del navegador.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.darlyntenelema.glassy">

    <!-- Permisos requeridos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Glassy"
        android:icon="@mipmap/app_icon"
        android:theme="@style/UnityThemeSelector">

        <!--
          ACTIVITY PRINCIPAL — UnityPlayerActivity
          launchMode="singleTask": garantiza que el deep link vuelva
          a la misma instancia en lugar de crear una Activity nueva.
        -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density">

            <!-- Intent filter para el launcher (icono del app) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              INTENT FILTER para el Deep Link OAuth
              Captura URLs con scheme "glassy", host "callback".
              Ejemplo: glassy://callback#access_token=eyJ...
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="glassy"
                    android:host="callback" />
            </intent-filter>

        </activity>
    </application>

</manifest>
